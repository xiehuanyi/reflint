# --- RefLint configuration ------------------------------------------------
# Gemini API key (Google AI Studio). Not needed when DEMO_MODE=1.
GOOGLE_API_KEY=your-key-here

# Optional overrides -------------------------------------------------------
# Orchestrator model (Strands GeminiModel):
# REFLINT_MODEL=gemini-flash-lite-latest
# Claim-judge sub-agent model (separate free-tier quota bucket on purpose):
# REFLINT_JUDGE_MODEL=gemini-3.5-flash

# Run fully offline against recorded fixtures (no key, no network):
# DEMO_MODE=1

# During a live run, also record fixtures for later DEMO_MODE replay:
# RECORD_FIXTURES=1

# HTTP behavior for Crossref/OpenAlex/Semantic Scholar calls:
# REFLINT_HTTP_TIMEOUT=12
# REFLINT_CACHE_TTL=21600
